const express = require("express");
const app = express();
const PORT = 3000;

const userModel = require("./models/userModel");

app.set("view engine", "ejs"); // ✅ pakai EJS
app.set("views", "./views");   // folder tempat simpan ejs

// route untuk render index.ejs
app.get("/", (req, res) => {
  const users = userModel.findAll();
  res.render("index", { users }); // kirim data users ke index.ejs
});

app.listen(PORT, () => {
  console.log(`Server running at http://localhost:${PORT}`);
});
